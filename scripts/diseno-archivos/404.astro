---
// Página 404 de Mochileando sin Barreras.
// Astro la genera como /404.html, que Cloudflare, Netlify, Vercel y el nginx del
// proyecto sirven automáticamente cuando una URL no existe.
//
// Colores: tokens de src/assets/styles/tailwind.css (primary, primary-hover, accent-text, link, secondary).
// El foco de teclado lo gestiona la regla global :focus-visible de tailwind.css.
import Layout from '~/layouts/PageLayout.astro';
import { findLatestPosts } from '~/utils/blog';
import { getPermalink, getBlogPermalink } from '~/utils/permalinks';

export const prerender = true;

const metadata = {
  title: 'Página no encontrada',
  description:
    'La página que buscas no existe o ha cambiado de sitio. Vuelve al inicio o echa un vistazo a nuestras guías.',
  robots: { index: false, follow: false },
};

const posts = await findLatestPosts({ count: 3 });
---

<Layout metadata={metadata}>
  <section class="px-4 sm:px-6 py-12 md:py-20 mx-auto max-w-6xl">
    <div class="grid md:grid-cols-2 gap-10 md:gap-12 items-center">
      <!-- TEXTO -->
      <div class="md:order-1">
        <p class="text-sm font-bold uppercase tracking-widest text-accent-text mb-3">Error 404</p>
        <h1 class="text-4xl md:text-5xl font-bold font-heading leading-tight tracking-tighter mb-5">
          Nos hemos salido de la ruta
        </h1>
        <p class="text-lg text-muted mb-8 max-w-xl text-pretty">
          Esta página no aparece en nuestro mapa. Puede que la dirección esté mal escrita, que la hayamos movido de
          sitio o que todavía la estemos trayendo a la web nueva.
        </p>

        <div class="flex flex-col sm:flex-row gap-3 sm:gap-4">
          <a
            href={getPermalink('/')}
            class="inline-flex items-center justify-center rounded-full bg-primary hover:bg-primary-hover text-white font-semibold px-7 py-3.5 transition-colors motion-reduce:transition-none"
          >
            Volver al inicio
          </a>
          <a
            href={getBlogPermalink()}
            class="inline-flex items-center justify-center rounded-full border-2 border-primary dark:border-secondary text-link hover:bg-primary hover:text-white dark:hover:bg-secondary dark:hover:text-slate-900 font-semibold px-7 py-3 transition-colors motion-reduce:transition-none"
          >
            Ver las guías
          </a>
        </div>
      </div>

      <!-- ILUSTRACIÓN (decorativa) -->
      <div class="md:order-2 order-first max-w-md w-full mx-auto md:max-w-none" aria-hidden="true">
        <svg viewBox="0 0 560 420" xmlns="http://www.w3.org/2000/svg" class="w-full h-auto" focusable="false">
          <style is:inline>
            .e404-sky {
              fill: #e5f5f6;
            }
            .e404-sun {
              fill: #f4c2bc;
            }
            .e404-cloud {
              fill: #ffffff;
              opacity: 0.9;
            }
            .e404-hill-far {
              fill: #a5cfd2;
            }
            .e404-hill-mid {
              fill: #61b4ba;
            }
            .e404-hill-near {
              fill: #36a09f;
            }
            .e404-road {
              fill: #3b4756;
            }
            .e404-dash {
              fill: #faf9f6;
            }
            .e404-post {
              fill: #334155;
            }
            .e404-board-a {
              fill: #b4524a;
            }
            .e404-board-b {
              fill: #1f7f7e;
            }
            .e404-sign-text {
              fill: #ffffff;
              font-family: inherit;
              font-weight: 800;
            }
            .e404-van-body {
              fill: #f5f0e6;
              stroke: #cfc7b8;
              stroke-width: 2;
            }
            .e404-van-dark {
              fill: #334155;
            }
            .e404-van-logo {
              fill: #36a09f;
            }
            .e404-wheel {
              fill: #1e293b;
            }
            .e404-hub {
              fill: #cbd5e1;
            }
            .e404-shadow {
              fill: #000000;
              opacity: 0.22;
            }

            .dark .e404-sky {
              fill: #14263d;
            }
            .dark .e404-sun {
              fill: #d87068;
            }
            .dark .e404-cloud {
              fill: #2a3d58;
              opacity: 0.95;
            }
            .dark .e404-hill-far {
              fill: #1c4553;
            }
            .dark .e404-hill-mid {
              fill: #1f6469;
            }
            .dark .e404-hill-near {
              fill: #1a7a79;
            }
            .dark .e404-road {
              fill: #0b1220;
            }
            .dark .e404-dash {
              fill: #8aa0b6;
            }
            .dark .e404-post {
              fill: #94a3b8;
            }
            .dark .e404-van-body {
              stroke: #8f887a;
            }

            @media (prefers-reduced-motion: no-preference) {
              .e404-cloud-a {
                animation: e404-drift 26s ease-in-out infinite alternate;
              }
              .e404-cloud-b {
                animation: e404-drift 34s ease-in-out infinite alternate-reverse;
              }
              .e404-van {
                animation: e404-bob 3.4s ease-in-out infinite;
                transform-box: fill-box;
                transform-origin: center bottom;
              }
              @keyframes e404-drift {
                from {
                  transform: translateX(-14px);
                }
                to {
                  transform: translateX(14px);
                }
              }
              @keyframes e404-bob {
                0%,
                100% {
                  transform: translateY(0);
                }
                50% {
                  transform: translateY(-2px);
                }
              }
            }
          </style>

          <!-- Cielo -->
          <rect class="e404-sky" width="560" height="420" rx="32"></rect>
          <circle class="e404-sun" cx="440" cy="104" r="46"></circle>
          <g class="e404-cloud-a">
            <g class="e404-cloud">
              <ellipse cx="120" cy="86" rx="46" ry="15"></ellipse>
              <ellipse cx="150" cy="74" rx="30" ry="14"></ellipse>
            </g>
          </g>
          <g class="e404-cloud-b">
            <g class="e404-cloud">
              <ellipse cx="318" cy="52" rx="34" ry="11"></ellipse>
              <ellipse cx="340" cy="43" rx="22" ry="10"></ellipse>
            </g>
          </g>

          <!-- Montañas -->
          <path
            class="e404-hill-far"
            d="M0 250 L70 170 L128 222 L206 142 L296 236 L372 168 L460 230 L520 186 L560 214 V420 H0 Z"></path>
          <path
            class="e404-hill-mid"
            d="M0 286 C80 236 150 232 230 270 C310 306 380 238 460 252 C510 261 540 276 560 288 V420 H0 Z"></path>
          <path class="e404-hill-near" d="M0 330 C90 292 180 300 270 326 C360 352 450 306 560 322 V420 H0 Z"></path>

          <!-- Carretera sinuosa que se pierde en el horizonte -->
          <path
            class="e404-road"
            d="M262 268 C282 270 296 272 300 276 C340 300 420 340 470 420 H150 C196 360 250 312 232 292 C226 282 244 270 262 268 Z"
          ></path>
          <rect class="e404-dash" x="268" y="284" width="8" height="12" rx="3" transform="rotate(-6 272 290)"></rect>
          <rect class="e404-dash" x="284" y="312" width="10" height="16" rx="3" transform="rotate(-14 289 320)"></rect>
          <rect class="e404-dash" x="306" y="350" width="12" height="20" rx="3" transform="rotate(-24 312 360)"></rect>
          <rect class="e404-dash" x="336" y="392" width="14" height="24" rx="3" transform="rotate(-32 343 404)"></rect>

          <!-- Cartel de ruta -->
          <rect class="e404-post" x="96" y="196" width="10" height="170" rx="4"></rect>
          <path class="e404-board-a" d="M32 206 H128 L148 226 L128 246 H32 Q24 246 24 238 V214 Q24 206 32 206 Z"></path>
          <text class="e404-sign-text" x="76" y="237" font-size="26" text-anchor="middle">404</text>
          <path class="e404-board-b" d="M70 262 H172 Q180 262 180 270 V294 Q180 302 172 302 H70 L50 282 Z"></path>
          <text class="e404-sign-text" x="124" y="291" font-size="26" text-anchor="middle">¿?</text>

          <!-- Camper -->
          <g transform="translate(-64 0)">
            <g class="e404-van">
              <ellipse class="e404-shadow" cx="388" cy="372" rx="78" ry="7"></ellipse>
              <!-- panel solar -->
              <path class="e404-van-dark" d="M336 258 H400 L394 267 H342 Z"></path>
              <!-- caja -->
              <rect class="e404-van-body" x="320" y="266" width="96" height="84" rx="10"></rect>
              <!-- cabina -->
              <path class="e404-van-body" d="M416 292 H442 Q452 292 458 302 L470 328 Q474 336 474 344 V350 H416 Z"
              ></path>
              <path class="e404-van-dark" d="M424 300 H440 Q445 300 448 306 L456 324 H424 Z"></path>
              <!-- ventana y logo -->
              <rect class="e404-van-dark" x="338" y="284" width="30" height="20" rx="4"></rect>
              <circle class="e404-van-logo" cx="388" cy="318" r="11"></circle>
              <!-- ruedas -->
              <circle class="e404-wheel" cx="352" cy="352" r="16"></circle>
              <circle class="e404-hub" cx="352" cy="352" r="6"></circle>
              <circle class="e404-wheel" cx="448" cy="352" r="16"></circle>
              <circle class="e404-hub" cx="448" cy="352" r="6"></circle>
            </g>
          </g>
        </svg>
      </div>
    </div>
  </section>

  <!-- SUGERENCIAS -->
  <section class="px-4 sm:px-6 pb-16 md:pb-24 mx-auto max-w-6xl">
    <h2 class="text-2xl font-bold font-heading mb-6">Mientras te reubicas, quizá te interese</h2>

    <div class="grid gap-4 md:grid-cols-2 lg:grid-cols-4">
      <a
        href={getPermalink('/mejor-esim-para-viajar')}
        class="group flex flex-col justify-between rounded-2xl p-5 bg-primary text-white hover:bg-primary-hover transition-colors motion-reduce:transition-none"
      >
        <span class="text-xs font-bold uppercase tracking-widest opacity-90">Guía destacada</span>
        <span class="mt-3 text-lg font-semibold leading-snug">Mejor eSIM para viajar: comparativa real</span>
        <span class="mt-4 text-sm font-semibold underline underline-offset-4">Leer la comparativa →</span>
      </a>

      {
        posts.map((post) => (
          <a
            href={getPermalink(post.permalink, 'post')}
            class="group flex flex-col justify-between rounded-2xl p-5 bg-white dark:bg-slate-800 border border-gray-100 dark:border-slate-700 shadow-sm hover:shadow-md hover:-translate-y-0.5 transition motion-reduce:transition-none motion-reduce:hover:translate-y-0"
          >
            {post.category && (
              <span class="text-xs font-bold uppercase tracking-widest text-accent-text">{post.category.title}</span>
            )}
            <span class="mt-3 text-lg font-semibold leading-snug dark:text-slate-200">{post.title}</span>
            <span class="mt-4 text-sm font-semibold text-link group-hover:underline underline-offset-4">
              Leer el artículo →
            </span>
          </a>
        ))
      }
    </div>

    <p class="mt-10 text-muted">
      ¿Buscabas algo concreto? Escríbenos a
      <a href="mailto:equipo@mochileandosinbarreras.com" class="font-semibold text-link underline underline-offset-4"
        >equipo@mochileandosinbarreras.com</a
      > y te echamos una mano.
    </p>
  </section>
</Layout>
