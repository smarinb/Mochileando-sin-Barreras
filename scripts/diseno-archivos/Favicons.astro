---
// Favicons de Mochileando sin Barreras (globo con oreja del logo).
// .ico: multi-tamaño (16/32/48) para navegadores antiguos y pestañas.
// PNG 32/192: navegadores modernos y Android. apple-touch-icon: iOS (fondo crema, sin transparencia).
import favIco from '~/assets/favicons/favicon.ico';
import fav32 from '~/assets/favicons/favicon-32.png';
import fav192 from '~/assets/favicons/favicon-192.png';
import appleTouchIcon from '~/assets/favicons/apple-touch-icon.png';
---

<link rel="icon" href={favIco} sizes="48x48" />
<link rel="icon" type="image/png" sizes="32x32" href={fav32.src} />
<link rel="icon" type="image/png" sizes="192x192" href={fav192.src} />
<link rel="apple-touch-icon" sizes="180x180" href={appleTouchIcon.src} />
