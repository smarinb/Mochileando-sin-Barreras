---
import { APP_BLOG } from 'astrowind:config';
import type { Post } from '~/types';

import Image from '~/components/common/Image.astro';
import { findImage } from '~/utils/images';
import { getPermalink } from '~/utils/permalinks';

export interface Props {
  post: Post;
}

const { post } = Astro.props;
const image = await findImage(post.image);

const link = APP_BLOG?.post?.isEnabled ? getPermalink(post.permalink, 'post') : '';

// Miniatura optimizada (WebP responsive, recortada a 16:9). Antes se servía el archivo original
// sin procesar (150 KB por miniatura).
const imageProps = {
  widths: [240, 480, 720],
  sizes: '(max-width: 767px) 100vw, (max-width: 1023px) 400px, 300px',
  width: 480,
  height: 270,
  format: 'webp' as const,
  loading: 'lazy' as const,
  decoding: 'async' as const,
};
---

<article
  class="mb-6 transition intersect-once intersect-quarter motion-safe:md:opacity-0 motion-safe:md:intersect:animate-fade"
>
  <div class="relative w-full aspect-video mb-6 overflow-hidden rounded-xl shadow-lg">
    {
      image &&
        (link ? (
          <a href={link} class="block w-full h-full" tabindex="-1" aria-hidden="true">
            <Image
              src={image}
              alt=""
              class="w-full h-full object-cover transition-transform duration-500 hover:scale-105"
              {...imageProps}
            />
          </a>
        ) : (
          <Image src={image} alt="" class="w-full h-full object-cover" {...imageProps} />
        ))
    }
  </div>

  <h3 class="text-xl sm:text-2xl font-bold leading-tight mb-2 font-heading dark:text-slate-300">
    {
      link ? (
        <a class="inline-block hover:text-accent-text transition ease-in duration-200" href={link}>
          {post.title}
        </a>
      ) : (
        post.title
      )
    }
  </h3>

  <p class="text-muted dark:text-slate-400 text-lg">{post.excerpt}</p>
</article>
