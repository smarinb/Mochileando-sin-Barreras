---
// Logo del header. Se sirve como WebP responsive (2–13 KB según pantalla) en lugar del SVG
// de 117 KB (37 KB comprimido), que es un trazado vectorial con miles de puntos pensado para
// mostrarse a 56–80 px de alto. `logo-header.webp` se genera a partir del SVG original.
import { Image } from 'astro:assets';
import logoHeader from '~/assets/images/logo-header.webp';
---

<span
  class="self-center ml-2 rtl:ml-0 rtl:mr-2 text-2xl md:text-xl font-bold text-gray-900 whitespace-nowrap dark:text-white"
>
  <Image
    src={logoHeader}
    alt="Logo Mochileando sin Barreras"
    widths={[166, 332, 498]}
    sizes="(min-width: 768px) 166px, 116px"
    width={166}
    height={80}
    class="h-14 w-auto md:h-20"
    loading="eager"
    decoding="async"
  />
</span>
