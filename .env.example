# Cloudflare Turnstile (captcha del formulario de contacto): clave PÚBLICA del widget.
# Se define también en Cloudflare Pages → Settings → Variables (build). La clave secreta (TURNSTILE_SECRET) va solo en Pages, nunca en el repositorio.
PUBLIC_TURNSTILE_SITE_KEY=

# DataForSEO (scripts/dataforseo_seo.py): credenciales de API de https://app.dataforseo.com/api-access (NO la contraseña de la cuenta). Van en .env local, nunca en el repo.
DATAFORSEO_LOGIN=
DATAFORSEO_PASSWORD=
