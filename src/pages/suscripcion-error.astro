---
// Destino cuando el enlace de confirmación no es válido o ha caducado. No se indexa.
import Layout from '~/layouts/PageLayout.astro';

export const prerender = true;

const metadata = {
  title: 'No hemos podido confirmar tu suscripción',
  description: 'El enlace de confirmación no es válido o ha caducado.',
  robots: { index: false, follow: false },
};
---

<Layout metadata={metadata}>
  <section class="mx-auto max-w-3xl px-4 py-14 sm:px-6">
    <h1 class="font-heading text-3xl font-bold md:text-4xl">No hemos podido confirmar tu suscripción</h1>
    <p class="mt-4 text-lg text-slate-800 dark:text-slate-200">
      El enlace no es válido o ha caducado (dura 7 días). Puedes volver a apuntarte desde cualquier guía de
      <a href="/mejor-seguro-de-viaje">seguros</a>, <a href="/mejor-tarjeta-para-viajar">tarjetas</a> o
      <a href="/mejor-esim-para-viajar">eSIM</a>, o escribirnos a
      <a href="mailto:equipo@mochileandosinbarreras.com">equipo@mochileandosinbarreras.com</a> y lo solucionamos.
    </p>
  </section>
</Layout>
