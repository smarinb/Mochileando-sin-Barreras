    a: 'En la mayoría de casos no podrás volver a instalarla, ya que el código QR suele ser de un solo uso. Si ocurre, tendrás que contactar con soporte.',
  },
];

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map(({ q, a }) => ({
    '@type': 'Question',
    name: q,
    acceptedAnswer: { '@type': 'Answer', text: a },
