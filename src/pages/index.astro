---
import Layout from '~/layouts/PageLayout.astro';
import ClusterShowcase from '~/components/widgets/ClusterShowcase.astro';
import { Image, getImage } from 'astro:assets';
import heroImage from '~/assets/images/hero-image.webp';
import historiaImg from '~/assets/images/historia-cris-sergio.webp';
import libroImg from '~/assets/images/libro-quierete-sorda.webp';
import patagoniaImg from '~/assets/images/navegacion-glaciares-el-calafate.webp';
import esloveniaImg from '~/assets/images/que-ver-y-hacer-en-eslovenia.webp';
import siberiaImg from '~/assets/images/guia-siberia.webp';
import { Icon } from 'astro-icon/components';

// Hero (LCP): AVIF (calidad 45, indistinguible bajo el degradado) con WebP de reserva.
// En teléfonos (<= 640px) se ve el 37% central de la foto: se sirve un recorte vertical, no la imagen completa.
const heroWidths = [640, 960, 1280, 1600];
const heroSrcset = async (format: 'avif' | 'webp', quality: number) =>
  (
    await Promise.all(
      heroWidths.map(async (width) => `${(await getImage({ src: heroImage, width, format, quality })).src} ${width}w`)
    )
  ).join(', ');
const [heroAvif, heroWebp, heroFallback, phoneAvif, phoneWebp] = await Promise.all([
  heroSrcset('avif', 45),
  heroSrcset('webp', 60),
  getImage({ src: heroImage, width: 1280, format: 'webp', quality: 60 }),
  getImage({ src: heroImage, width: 750, height: 1050, fit: 'cover', format: 'avif', quality: 45 }),
  getImage({ src: heroImage, width: 750, height: 1050, fit: 'cover', format: 'webp', quality: 60 }),
]);

const destinosHome = [
  {
    href: '/guia-patagonia',
    img: patagoniaImg,
    alt: 'Sergio y Cris sonriendo a bordo de un barco con un témpano de hielo de fondo en el Lago Argentino',
    title: 'Patagonia por libre',
    text: 'Ballenas, glaciares, pingüinos y la Ruta 25: nuestra ruta en camper por Argentina y Chile.',
    cta: 'Ver la guía de la Patagonia',
  },
  {
    href: '/que-ver-y-hacer-en-eslovenia',
    img: esloveniaImg,
    alt: 'Grupo de viajeros junto al lago Bled con los Alpes Julianos al fondo',
    title: 'Eslovenia',
    text: 'De Liubliana al lago Bled, las cuevas de Postojna y el valle del Soča.',
    cta: 'Ver qué ver en Eslovenia',
  },
  {
    href: '/guia-siberia',
    img: siberiaImg,
    alt: 'Mujer con abrigo de piel junto a una casa de madera tradicional siberiana',
    title: 'Siberia',
    text: 'Transiberiano, Irkutsk y el lago Baikal helado: guía, ropa y consejos para el invierno.',
    cta: 'Ver la guía de Siberia',
  },
];

const metadata = {
  title: 'Mochileando sin Barreras — Seguros, eSIMs y guías de viaje reales',
  ignoreTitleTemplate: true,
};
---

<Layout metadata={metadata}>
  <!-- HERO PRINCIPAL -->
  <section class="relative flex items-center justify-center min-h-[70vh] md:min-h-[85vh] overflow-hidden">
    <div class="absolute inset-0 z-0">
      <picture class="block h-full w-full">
        <source media="(max-width: 640px)" type="image/avif" srcset={phoneAvif.src} />
        <source media="(max-width: 640px)" type="image/webp" srcset={phoneWebp.src} />
        <source type="image/avif" srcset={heroAvif} sizes="100vw" />
        <source type="image/webp" srcset={heroWebp} sizes="100vw" />
        <img
          src={heroFallback.src}
          alt="Sergio y Cris viajando en campervan de Argentina a Alaska"
          width="1600"
          height="900"
          class="w-full h-full object-cover object-center"
          loading="eager"
          fetchpriority="high"
          decoding="async"
        />
      </picture>
      <div class="absolute inset-0 bg-gradient-to-b from-black/80 via-black/30 to-black/90"></div>
    </div>

    <div class="relative z-10 max-w-5xl mx-auto px-4 sm:px-6 text-center text-white flex flex-col justify-between h-full py-12 md:py-24 mt-8 md:mt-0">
      <div class="mb-auto">
        <h1 class="text-4xl md:text-5xl lg:text-6xl font-bold leading-tight mb-6 drop-shadow-lg">
          <span class="text-accent-soft">Viajar sin barreras:</span><br />
          <span class="text-white">rutas reales, seguros y herramientas para viajar tranquilo</span>
        </h1>
      </div>

      <div class="mt-auto pt-20 md:pt-40">
        <p class="text-lg md:text-xl text-gray-100 mb-8 max-w-3xl mx-auto drop-shadow-md font-medium">
          Vivimos recorriendo de Argentina a Alaska en camper, compartiendo guías honestas, el mejor asesoramiento en seguros y recursos para viajar sin complicaciones.
        </p>
        
        <!-- CTAs de Máxima Monetización orientados a Seguros y eSIMs -->
        <div class="flex flex-col sm:flex-row justify-center gap-4">
          <a href="/descuento-heymondo" 
             class="btn w-full sm:w-auto bg-primary text-white border-none hover:bg-primary-hover shadow-xl font-semibold text-lg px-8">
            <Icon name="tabler:shield-check" class="mr-2 h-5 w-5" aria-hidden="true" />5% Descuento Seguro Heymondo
          </a>
          <a href="/mejor-esim-para-viajar" 
             class="btn w-full sm:w-auto bg-white text-gray-900 border-none hover:bg-gray-200 shadow-xl font-semibold text-lg px-8">
            <Icon name="tabler:world" class="mr-2 h-5 w-5" aria-hidden="true" />Mejor eSIM para Viajar
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- SECCIÓN DE HERRAMIENTAS CLAVE (Optimizada para Monetización: Seguros primero) -->
  <section class="py-16 px-6 max-w-6xl mx-auto">
    <div class="text-center mb-12">
      <h2 class="text-3xl font-bold font-heading dark:text-white mb-4">Herramientas que usamos para viajar sin preocupaciones</h2>
      <p class="text-muted dark:text-slate-400 max-w-2xl mx-auto text-lg">
        Después de años en la carretera, estas son las opciones en las que confiamos para ahorrar dinero y estar cubiertos ante cualquier imprevisto.
      </p>
    </div>

    <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-8">
      <!-- 1. SEGUROS (Nuestra máxima prioridad de ingresos) -->
      <div class="bg-white dark:bg-slate-800 p-8 rounded-2xl shadow-lg border border-gray-100 dark:border-slate-700 flex flex-col justify-between transition hover:-translate-y-1">
        <div>
          <div class="mb-4 inline-flex h-12 w-12 items-center justify-center rounded-xl bg-primary/10 text-link"><Icon name="tabler:shield-check" class="h-7 w-7" aria-hidden="true" /></div>
          <h3 class="text-xl font-bold mb-2 dark:text-white">Seguro de Viaje con Descuento</h3>
          <p class="text-muted dark:text-slate-400 text-sm mb-6">
            Asistencia médica 24/7, repatriación y cobertura de material tecnológico sin adelantar dinero de tu bolsillo.
          </p>
        </div>
        <a href="/mejor-seguro-de-viaje" class="btn bg-primary text-white hover:bg-primary-hover text-center py-2.5 rounded-xl font-semibold">
          Ver Seguros Recomendados
        </a>
        <a href="/category/seguros-de-viaje" class="mt-3 text-center text-sm font-semibold text-link hover:underline">Ver todas las guías de seguros →</a>
      </div>

      <!-- 2. eSIMs (Alto volumen de conversión) -->
      <div class="bg-white dark:bg-slate-800 p-8 rounded-2xl shadow-lg border border-gray-100 dark:border-slate-700 flex flex-col justify-between transition hover:-translate-y-1">
        <div>
          <div class="mb-4 inline-flex h-12 w-12 items-center justify-center rounded-xl bg-primary/10 text-link"><Icon name="tabler:wifi" class="h-7 w-7" aria-hidden="true" /></div>
          <h3 class="text-xl font-bold mb-2 dark:text-white">Internet con eSIM de Viaje</h3>
          <p class="text-muted dark:text-slate-400 text-sm mb-6">
            Conéctate a internet nada más aterrizar en cualquier país sin depender de redes Wi-Fi públicas e inseguras.
          </p>
        </div>
        <a href="/mejor-esim-para-viajar" class="btn bg-primary text-white hover:bg-primary-hover text-center py-2.5 rounded-xl font-semibold">
          Comparativa de eSIMs
        </a>
        <a href="/category/esim-para-viajar" class="mt-3 text-center text-sm font-semibold text-link hover:underline">Ver todas las guías de eSIM →</a>
      </div>

      <!-- 3. TARJETAS BANCARIAS -->
      <div class="bg-white dark:bg-slate-800 p-8 rounded-2xl shadow-lg border border-gray-100 dark:border-slate-700 flex flex-col justify-between transition hover:-translate-y-1">
        <div>
          <div class="mb-4 inline-flex h-12 w-12 items-center justify-center rounded-xl bg-primary/10 text-link"><Icon name="tabler:credit-card" class="h-7 w-7" aria-hidden="true" /></div>
          <h3 class="text-xl font-bold mb-2 dark:text-white">Tarjetas sin Comisiones</h3>
          <p class="text-muted dark:text-slate-400 text-sm mb-6">
            Las tarjetas que llevamos en la guantería de la camper para pagar y sacar cajeros en el extranjero al mejor tipo de cambio.
          </p>
        </div>
        <a href="/mejor-tarjeta-para-viajar" class="btn bg-primary text-white hover:bg-primary-hover text-center py-2.5 rounded-xl font-semibold">
          Ver Tarjetas para Viajar
        </a>
        <a href="/category/tarjetas-para-viajar" class="mt-3 text-center text-sm font-semibold text-link hover:underline">Ver todas las guías de tarjetas →</a>
      </div>

      <!-- 4. ALQUILER DE COCHES -->
      <div class="bg-white dark:bg-slate-800 p-8 rounded-2xl shadow-lg border border-gray-100 dark:border-slate-700 flex flex-col justify-between transition hover:-translate-y-1">
        <div>
          <div class="mb-4 inline-flex h-12 w-12 items-center justify-center rounded-xl bg-primary/10 text-link"><Icon name="tabler:car" class="h-7 w-7" aria-hidden="true" /></div>
          <h3 class="text-xl font-bold mb-2 dark:text-white">Alquiler de Coches</h3>
          <p class="text-muted dark:text-slate-400 text-sm mb-6">
            Fianza, seguros y tarjeta: cómo reservar tu coche de alquiler sin sorpresas en el mostrador.
          </p>
        </div>
        <a href="/mejor-alquiler-de-coches" class="btn bg-primary text-white hover:bg-primary-hover text-center py-2.5 rounded-xl font-semibold">
          Comparar Alquiler de Coches
        </a>
        <a href="/category/alquiler-de-coches" class="mt-3 text-center text-sm font-semibold text-link hover:underline">Ver todas las guías de alquiler →</a>
      </div>
    </div>
  </section>

  <!-- DESTINOS (rutas reales: la parte de contenido que atrae tráfico y lleva a las herramientas) -->
  <section class="py-16 px-6 max-w-6xl mx-auto" aria-labelledby="destinos-home">
    <div class="text-center mb-12">
      <h2 id="destinos-home" class="text-3xl font-bold font-heading dark:text-white mb-4">Destinos que hemos recorrido</h2>
      <p class="text-muted dark:text-slate-400 max-w-2xl mx-auto text-lg">
        Rutas, excursiones y precios reales, con las herramientas que necesitas para organizar cada viaje.
      </p>
    </div>

    <ul class="grid md:grid-cols-3 gap-8">
      {
        destinosHome.map((d) => (
          <li>
            <a href={d.href} class="group flex h-full flex-col overflow-hidden rounded-2xl border border-gray-100 bg-white shadow-lg transition hover:-translate-y-1 dark:border-slate-700 dark:bg-slate-800">
              <Image src={d.img} alt={d.alt} widths={[360, 720]} sizes="(max-width: 767px) 100vw, 360px" class="aspect-video w-full object-cover" loading="lazy" />
              <div class="flex flex-1 flex-col p-6">
                <h3 class="mb-2 text-xl font-bold dark:text-white group-hover:text-link">{d.title}</h3>
                <p class="mb-4 text-sm text-muted dark:text-slate-400">{d.text}</p>
                <span class="mt-auto text-sm font-semibold text-link">{d.cta} →</span>
              </div>
            </a>
          </li>
        ))
      }
    </ul>

    <p class="mt-8 text-center text-sm font-semibold">
      <a href="/destinos" class="text-link hover:underline">Ver todos los destinos →</a>
    </p>
  </section>

  <!-- HISTORIA Y PROPÓSITO (Conexión humana y marca personal) -->
  <section class="bg-gray-50 dark:bg-slate-900 py-16 px-6">
    <div class="max-w-5xl mx-auto grid md:grid-cols-2 gap-12 items-center">
      <div>
        <span class="text-accent-text font-bold uppercase tracking-wider text-sm">Un viaje con propósito</span>
        <h2 class="text-3xl font-bold font-heading dark:text-white mt-2 mb-4">Viajar siendo sorda: nuestra forma de ver el mundo</h2>
        <p class="text-muted dark:text-slate-400 mb-4 text-base leading-relaxed">
          Mochileando Sin Barreras nació tras dar la vuelta al mundo a dedo (puedes leer <a href="/vuelta-al-mundo" class="font-semibold text-link hover:underline">nuestro diario mes a mes</a>). Cris tiene hipoacusia bilateral y en el camino nos hemos enfrentado a barreras de comunicación e incertidumbres que nos volvieron más resilientes.
        </p>
        <p class="text-muted dark:text-slate-400 mb-6 text-base leading-relaxed">
          Lejos de frenarnos, nos impulsó a compartir una manera de viajar más consciente, accesible y humana. Hoy seguimos ese camino desde nuestra camper rumbo a Alaska.
        </p>
        <a href="/acerca-de" class="text-accent-text font-bold hover:underline inline-flex items-center gap-2">
          Conoce nuestra historia completa →
        </a>
        <p class="mt-4 text-sm">
          ¿Viajas con sordera o hipoacusia? Empieza por nuestra <a href="/viajar-siendo-sordo" class="font-semibold text-link hover:underline">guía para viajar siendo sordo</a>.
        </p>
      </div>
      <div class="relative rounded-2xl overflow-hidden shadow-xl">
        <Image src={historiaImg} alt="Cristina y Sergio viajando" widths={[480, 960]} sizes="(max-width: 768px) 100vw, 480px" class="w-full h-auto object-cover" loading="lazy" />
      </div>
    </div>
  </section>

  <!-- SECCIÓN DEL LIBRO "¡Quiérete Sorda!" (Autoridad y Conversión Emocional) -->
  <section class="py-16 px-6 max-w-4xl mx-auto">
    <div class="bg-white dark:bg-slate-800 p-8 md:p-12 rounded-3xl shadow-xl border border-gray-100 dark:border-slate-700">
      <div class="text-center mb-8">
        <h2 class="text-3xl font-bold dark:text-white mb-3">Una historia real que empezó todo</h2>
        <p class="text-muted dark:text-slate-400">Antes de Mochileando Sin Barreras, hubo un viaje y una historia que necesitaba ser contada.</p>
      </div>

      <div class="grid md:grid-cols-3 gap-8 items-center mb-10">
        <div class="text-center">
          <Image src={libroImg} alt="Libro Quiérete Sorda" widths={[200, 400]} sizes="200px" class="max-w-[200px] mx-auto rounded-xl shadow-md" loading="lazy" />
        </div>
        <div class="md:col-span-2 space-y-4 text-muted dark:text-slate-300">
          <p><strong>“¡Quiérete Sorda!”</strong> es el relato personal de Cristina enfrentándose al mundo, rompiendo barreras y encontrando su libertad viajando sola.</p>
          <p>Es la semilla de este proyecto. Si te identificas con nuestra forma de ver los viajes, este libro te va a emocionar y acompañar de verdad.</p>
        </div>
      </div>

      <div class="text-center">
        <a href="https://mochileandosinbarreras.com/producto/libro-quierete-sorda/" target="_blank" class="btn bg-primary text-white hover:bg-primary-hover px-8 py-3 rounded-xl font-bold shadow-lg inline-flex items-center gap-2">
          <Icon name="tabler:book-2" class="h-5 w-5" aria-hidden="true" />Descubrir el libro
        </a>
      </div>
    </div>
  </section>

  <!-- ÚLTIMAS GUÍAS POR TEMA (clústeres: enlaza a cada categoría y a su pilar) -->
  <ClusterShowcase count={3} />
</Layout>