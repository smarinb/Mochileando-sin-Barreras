---
import type { InferGetStaticPropsType, GetStaticPaths } from 'astro';
import { blogCategoryRobots, getStaticPathsBlogCategory } from '~/utils/blog';

import Layout from '~/layouts/PageLayout.astro';
import BlogList from '~/components/blog/List.astro';
import Headline from '~/components/blog/Headline.astro';
import Pagination from '~/components/blog/Pagination.astro';
import Breadcrumbs from '~/components/common/Breadcrumbs.astro';
import ClusterTabs from '~/components/blog/ClusterTabs.astro';
import { getClusterBySlug } from '~/data/clusters';
import { getPermalink, getBlogPermalink } from '~/utils/permalinks';

export const prerender = true;

export const getStaticPaths = (async ({ paginate }) => {
  return await getStaticPathsBlogCategory({ paginate });
}) satisfies GetStaticPaths;

type Props = InferGetStaticPropsType<typeof getStaticPaths> & { category: Record<string, string> };

const { page, category } = Astro.props as Props;

const currentPage = page.currentPage ?? 1;
const cluster = getClusterBySlug(category.slug);

const breadcrumbs = [
  { text: 'Inicio', href: getPermalink('/') },
  { text: 'Blog', href: getBlogPermalink() },
  ...(currentPage > 1
    ? [{ text: category.title, href: getPermalink(category.slug, 'category') }, { text: `Página ${currentPage}` }]
    : [{ text: category.title }]),
];

const pageSuffix = currentPage > 1 ? ` — Página ${currentPage}` : '';
const metadata = {
  title: `${cluster?.metaTitle ?? category.title}${pageSuffix}`,
  description:
    cluster?.metaDescription ??
    `Artículos de la categoría ${category.title} en el blog de Mochileando sin Barreras: guías, comparativas y recursos para viajar.`,
  robots: {
    index: blogCategoryRobots?.index && currentPage === 1,
    follow: blogCategoryRobots?.follow,
  },
};
---

<Layout metadata={metadata}>
  <Breadcrumbs bar items={breadcrumbs} />
  <section class="px-4 md:px-6 py-12 sm:py-16 lg:py-20 mx-auto max-w-4xl">
    <Headline subtitle={currentPage === 1 ? cluster?.intro : undefined}>{cluster?.h1 ?? category.title}</Headline>
    <ClusterTabs current={category.slug} />
    {
      cluster?.pillar && currentPage === 1 && (
        <a
          href={cluster.pillar.href}
          class="block mb-10 rounded-2xl border-l-4 border-primary bg-gray-50 dark:bg-slate-900 p-5 shadow-sm hover:shadow-md transition not-prose"
        >
          <span class="block text-xs font-semibold uppercase tracking-wide text-link">Empieza por aquí</span>
          <span class="block text-xl font-bold dark:text-white">{cluster.pillar.title}</span>
          <span class="block text-sm text-slate-600 dark:text-slate-300">{cluster.pillar.cta} →</span>
        </a>
      )
    }
    <BlogList posts={page.data} />
    <Pagination prevUrl={page.url.prev} nextUrl={page.url.next} />
  </section>
</Layout>
