---
import Layout from '~/layouts/PageLayout.astro';
import Breadcrumbs from '~/components/common/Breadcrumbs.astro';
import { Icon } from 'astro-icon/components';
import { clusters } from '~/data/clusters';
import { fetchPosts } from '~/utils/blog';
import { getPermalink } from '~/utils/permalinks';

const metadata = {
  title: 'Destinos: guías de viaje por libre y rutas reales',
  description:
    'Guías de viaje por libre de la Patagonia, Eslovenia y Siberia: rutas, excursiones, precios y consejos de nuestros viajes, con enlaces a seguros, eSIM y coches.',
  canonical: '/destinos',
};

const breadcrumbs = [{ text: 'Inicio', href: getPermalink('/') }, { text: 'Destinos' }];

const all = await fetchPosts();
const destinos = clusters
  .filter((c) => c.group === 'destinos')
  .map((c) => ({ ...c, total: all.filter((p) => p.category?.title === c.category).length }))
  .filter((c) => c.total > 0);
---

<Layout metadata={metadata}>
  <Breadcrumbs bar items={breadcrumbs} />

  <section class="px-4 py-16 sm:px-6 mx-auto lg:px-8 max-w-5xl">
    <h1 class="text-3xl md:text-4xl font-bold font-heading mb-4">Destinos: guías de viaje por libre y rutas reales</h1>
    <p class="mb-10 max-w-3xl text-lg text-slate-700 dark:text-slate-300">
      Estas son las zonas que hemos recorrido y contado con detalle. Cada una tiene una guía principal y todos los artículos con precios,
      excursiones y consejos prácticos.
    </p>

    <ul class="grid gap-6 md:grid-cols-2">
      {
        destinos.map((d) => (
          <li class="flex flex-col rounded-2xl border border-gray-100 bg-white p-6 shadow-md dark:border-slate-700 dark:bg-slate-800">
            <div class="mb-4 inline-flex h-12 w-12 items-center justify-center rounded-xl bg-primary/10 text-link">
              <Icon name={d.icon} class="h-7 w-7" aria-hidden="true" />
            </div>
            <h2 class="mb-2 text-2xl font-bold font-heading">
              <a href={d.pillar?.href ?? getPermalink(d.slug, 'category')} class="hover:text-link">{d.label}</a>
            </h2>
            <p class="mb-5 text-slate-700 dark:text-slate-300">{d.intro}</p>
            <div class="mt-auto flex flex-col gap-2 text-sm font-semibold">
              {d.pillar && (
                <a href={d.pillar.href} class="text-link hover:underline">
                  {d.pillar.cta} →
                </a>
              )}
              <a href={getPermalink(d.slug, 'category')} class="text-link hover:underline">
                Ver las {d.total} guías de {d.inline} →
              </a>
            </div>
          </li>
        ))
      }
    </ul>

    <div class="prose dark:prose-invert max-w-none mt-14">
      <h2>🧭 ¿Viajas con sordera o hipoacusia?</h2>
      <p>
        Todas nuestras guías están escritas por una viajera sorda y su pareja. Si quieres consejos específicos de accesibilidad, empieza por la guía de
        <a href="/viajar-siendo-sordo">viajar siendo sordo</a>.
      </p>
      <h2>🧳 Prepara tu viaje</h2>
      <ul>
        <li><a href="/mejor-alquiler-de-coches">Alquiler de coches</a>: cómo reservar sin sorpresas en la fianza.</li>
        <li><a href="/mejor-seguro-de-viaje">Seguro de viaje</a>: qué cubre de verdad y cómo conseguir descuento.</li>
        <li><a href="/mejor-esim-para-viajar">eSIM para viajar</a>: internet desde que aterrizas.</li>
        <li><a href="/mejor-tarjeta-para-viajar">Tarjeta para viajar</a>: paga sin comisiones en el extranjero.</li>
      </ul>
    </div>
  </section>
</Layout>
