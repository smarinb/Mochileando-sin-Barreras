---
import { ANALYTICS } from 'astrowind:config';

// Google Analytics solo se carga cuando el usuario lo acepta en el banner (CookieConsent.astro lee `data-id`).
const id = ANALYTICS?.vendors?.googleAnalytics?.id ? String(ANALYTICS.vendors.googleAnalytics.id) : '';
---

<meta id="ga-init" data-id={id} />
