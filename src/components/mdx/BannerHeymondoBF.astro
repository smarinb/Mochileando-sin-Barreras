---
/**
 * Banner Black Friday de Heymondo (campaña 19-30 nov 2026, 15 % sobre el enlace de afiliado).
 * Web estática: la ventana de fechas se comprueba en el navegador (hora de Madrid),
 * así que el banner está oculto y solo se muestra del 19 al 30 de noviembre.
 * No hace falta redeploy ni el día 19 ni el 1 de diciembre.
 * Retirarlo del código después de la campaña (buscar «BannerHeymondoBF»).
 */
const HEYMONDO_BF_URL =
  'https://heymondo.es/?utm_medium=Afiliado&utm_source=MOCHILEANDOSINBARRERAS&utm_campaign=PRINCIPAL&cod_descuento=MOCHILEANDOSINBARRERAS&ag_campaign=BLACKFRIDAY&agencia=a5108849b9020a8d726cf95f432afb343ac8';

const DESDE = '2026-11-19';
const HASTA = '2026-11-30';
---

<aside
  class="heymondo-bf not-prose my-8 rounded-xl border-l-4 border-[#D87068] bg-orange-50 p-4 dark:bg-slate-800"
  data-desde={DESDE}
  data-hasta={HASTA}
  aria-label="Oferta de Black Friday de Heymondo"
  hidden
>
  <div class="flex flex-col items-start justify-between gap-4 sm:flex-row sm:items-center">
    <div>
      <p class="m-0 text-base font-bold text-slate-800 dark:text-slate-100">
        Black Friday Heymondo: 15 % de descuento del 19 al 30 de noviembre
      </p>
      <p class="mt-1 mb-0 text-sm text-slate-700 dark:text-slate-300">
        Se aplica solo al entrar desde nuestro enlace y se acumula con los descuentos de familia, grupo y franquicia.
      </p>
    </div>
    <a
      href={HEYMONDO_BF_URL}
      target="_blank"
      rel="nofollow sponsored noopener noreferrer"
      class="w-full whitespace-nowrap rounded-lg bg-[#36A09F] px-5 py-2.5 text-center text-sm font-bold text-white no-underline shadow transition hover:bg-[#2c8584] sm:w-auto"
    >
      Ver mi precio con -15 %
    </a>
  </div>
  <p class="mt-2 mb-0 text-xs text-slate-600 dark:text-slate-400">
    Publicidad · enlace de afiliado. Mismo precio para ti y una pequeña comisión para nosotros.
  </p>
</aside>

<script>
  const hoyMadrid = new Intl.DateTimeFormat('en-CA', { timeZone: 'Europe/Madrid' }).format(new Date());
  document.querySelectorAll<HTMLElement>('.heymondo-bf').forEach((el) => {
    const { desde, hasta } = el.dataset;
    if (desde && hasta && hoyMadrid >= desde && hoyMadrid <= hasta) el.hidden = false;
  });
</script>
