---
/**
 * Bloque «Todo sobre Heymondo»: malla de enlaces entre las guías del clúster, con la página de descuento en primer lugar.
 * Uso en MDX: <HeymondoGuias actual="/heymondo-es-fiable" />  (la guía actual no se muestra).
 */
export interface Props {
  actual?: string;
}
const { actual } = Astro.props;

const guias = [
  { href: '/descuento-heymondo', titulo: 'Descuento Heymondo', texto: '5% automático, campañas del 15% y cómo llegar a ~40%.', destacada: true },
  { href: '/heymondo-opiniones', titulo: 'Opiniones de Heymondo', texto: 'Planes 2026, pros, contras y nuestra experiencia con la app.' },
  { href: '/heymondo-es-fiable', titulo: '¿Heymondo es fiable?', texto: 'Quién está detrás y cómo evitar webs falsas.' },
  { href: '/que-no-cubre-heymondo', titulo: 'Qué no cubre Heymondo', texto: 'Las exclusiones reales de la póliza.' },
  { href: '/como-reclamar-seguro-heymondo', titulo: 'Cómo reclamar', texto: 'Pasos, documentos y plazos del reembolso.' },
  { href: '/seguro-cancelacion-heymondo', titulo: 'Seguro de cancelación', texto: 'Las causas cubiertas y cuándo contratarlo.' },
  { href: '/heymondo-anual-o-larga-estancia', titulo: 'Anual o larga estancia', texto: 'Qué póliza elegir según cuánto viajes.' },
  { href: '/vuelo-retrasado-heymondo', titulo: 'AirHelp y Salas VIP', texto: 'Qué cubren si se retrasa tu vuelo.' },
  { href: '/heymondo-o-iati', titulo: 'Heymondo o IATI', texto: 'Comparativa con 31 simulaciones de precio.' },
  { href: '/seguro-de-viaje-para-sordos', titulo: 'Seguro para personas sordas', texto: 'Qué mirar si tienes hipoacusia.' },
  { href: '/heymondo-top-o-premium', titulo: 'Heymondo Top o Premium', texto: 'Diferencias reales y cuánto cuesta cada uno.' },
  { href: '/cuanto-cuesta-heymondo', titulo: '¿Cuánto cuesta Heymondo?', texto: 'Precios reales por plan, duración y viajeros.' },
  { href: '/heymondo-deportes-aventura', titulo: 'Deportes de aventura', texto: 'Qué actividades cubre y cuáles quedan fuera.' },
  { href: '/app-heymondo', titulo: 'App de Heymondo', texto: 'Chat médico, videoconsulta y llamada gratis.' },
  { href: '/heymondo-furgoneta-camper', titulo: 'Heymondo en furgoneta', texto: 'Equipaje, avería y acampada libre: qué cubre y qué no.' },
  { href: '/heymondo-sin-llamar-por-telefono', titulo: 'Avisar sin llamar', texto: 'Vías por escrito de cada aseguradora, para personas sordas.' },
].filter((g) => g.href !== actual);
---

<nav class="not-prose my-10 rounded-2xl border border-gray-200 bg-white p-5 shadow-sm dark:border-slate-700 dark:bg-slate-800" aria-labelledby="heymondo-guias-titulo">
  <h2 id="heymondo-guias-titulo" class="mb-4 text-lg font-bold text-slate-900 dark:text-white">Todo sobre Heymondo, en un solo sitio</h2>
  <ul class="grid gap-3 sm:grid-cols-2">
    {
      guias.map((g) => (
        <li>
          <a
            href={g.href}
            class:list={[
              'block h-full rounded-xl border p-3 no-underline transition hover:shadow-md',
              g.destacada ? 'border-primary bg-teal-50 dark:bg-slate-900' : 'border-gray-200 dark:border-slate-700',
            ]}
          >
            <span class="block font-semibold text-[#14605f] dark:text-link">{g.titulo}</span>
            <span class="mt-1 block text-sm text-slate-700 dark:text-slate-300">{g.texto}</span>
          </a>
        </li>
      ))
    }
  </ul>
</nav>
