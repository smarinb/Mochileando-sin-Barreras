---
/**
 * Barra lateral sticky (solo ≥ xl) de los posts comerciales: tarjetas de afiliado.
 * Las tarjetas del clúster del post aparecen primero.
 */
import { Icon } from 'astro-icon/components';
import { afiliadosPara } from '~/data/afiliados';

export interface Props {
  cluster?: string;
}
const { cluster } = Astro.props;
const items = afiliadosPara(cluster, 4);
---

<aside class="hidden xl:block not-prose" aria-labelledby="sidebar-herramientas">
  <div class="sticky top-24 max-h-[calc(100vh-7rem)] space-y-4 overflow-y-auto overscroll-contain pb-2 pr-1" tabindex="0" role="region" aria-label="Herramientas recomendadas">

    <h2 id="sidebar-herramientas" class="flex items-center gap-2 text-sm font-bold uppercase tracking-wider text-slate-700 dark:text-slate-200">
      <span class="h-px w-6 bg-accent" aria-hidden="true"></span>Lo que usamos nosotros
    </h2>
    {
      items.map((a, i) => (
        <div
          class:list={[
            'rounded-2xl border bg-white p-4 shadow-sm dark:bg-slate-800',
            i === 0 ? 'border-primary ring-1 ring-primary/30' : 'border-gray-200 dark:border-slate-700',
          ]}
        >
          <p class="text-base font-bold text-slate-900 dark:text-white">{a.name}</p>
          <p class="mt-1 text-sm text-slate-700 dark:text-slate-300">{a.benefit}</p>
          <a
            href={a.href}
            target="_blank"
            rel="nofollow sponsored noopener"
            class="mt-3 block rounded-lg bg-primary px-4 py-2 text-center text-sm font-bold text-white no-underline transition hover:bg-primary-hover"
          >
            {a.cta} →<span class="sr-only"> ({a.name}, se abre en una pestaña nueva)</span>
          </a>
          {a.review && (
            <a href={a.review.href} class="mt-2 block text-center text-xs font-semibold text-[#14605f] hover:underline dark:text-link">
              {a.review.text}
            </a>
          )}
        </div>
      ))
    }
    <a
      href="/heymondo-o-iati"
      class="flex items-center justify-between rounded-2xl bg-[#FDF2F0] p-4 text-sm font-semibold text-[#8a3c35] no-underline transition hover:shadow-md dark:bg-slate-800 dark:text-accent-text"
    >
      <span>¿Heymondo o IATI? Comparativa con 31 simulaciones de precio</span>
      <Icon name="tabler:arrow-right" class="ml-2 h-5 w-5 shrink-0" aria-hidden="true" />
    </a>
    <p class="text-xs leading-relaxed text-slate-600 dark:text-slate-400">
      Si contratas desde estos enlaces recibimos una comisión sin coste extra para ti.
      <a href="/acerca-de#como-trabajamos" class="underline">Cómo trabajamos</a>.
    </p>
  </div>
</aside>
