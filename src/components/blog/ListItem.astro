---
import type { Post } from '~/types';
import Image from '~/components/common/Image.astro';
import { findImage } from '~/utils/images';
import { getPermalink } from '~/utils/permalinks';
import { getFormattedDate } from '~/utils/utils';

export interface Props {
  post: Post;
}

const { post } = Astro.props;
const image = await findImage(post.image);
const link = getPermalink(post.permalink, 'post');
---

<article class="grid md:grid-cols-3 gap-6 mb-10 items-center">
  {
    image && (
      <div class="relative md:col-span-1 aspect-video rounded-xl shadow-md overflow-hidden bg-transparent">
        <a href={link} class="block w-full h-full" tabindex="-1" aria-hidden="true">
          <Image
            src={image}
            class="w-full h-full object-cover transition-transform duration-500 hover:scale-105"
            widths={[400, 900]}
            width={600}
            height={338}
            sizes="(max-width: 768px) 100vw, 400px"
            alt=""
            format="webp"
            loading="lazy"
            decoding="async"
          />
        </a>
      </div>
    )
  }
  <div class={`${image ? 'md:col-span-2' : 'md:col-span-3'}`}>
    <header>
      <div class="flex items-center text-xs text-muted dark:text-slate-400 mb-2">
        {post.publishDate && <time datetime={String(post.publishDate)}>{getFormattedDate(post.publishDate)}</time>}
        {
          post.category && (
            <>
              <span class="mx-2">•</span>
              <a class="hover:underline" href={getPermalink(post.category.slug, 'category')}>
                {post.category.title}
              </a>
            </>
          )
        }
      </div>
      <h2 class="text-xl sm:text-2xl font-bold leading-tight mb-2 font-heading dark:text-slate-300">
        <a class="inline-block hover:text-accent-text transition ease-in duration-200" href={link}>
          {post.title}
        </a>
      </h2>
    </header>
    {post.excerpt && <p class="text-muted dark:text-slate-400 text-base">{post.excerpt}</p>}
  </div>
</article>