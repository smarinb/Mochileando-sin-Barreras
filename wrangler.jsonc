// Cloudflare Workers configuration for the "Deploy to Cloudflare" button in the
// README. The site is fully static, so the
// Worker only serves the `dist/` folder as assets; no adapter is needed.
// Docs: https://developers.cloudflare.com/workers/static-assets/
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "astrowind",
  "compatibility_date": "2026-09-01",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page",
    // Las URLs canónicas del sitio no llevan barra final (trailingSlash: false). Con el valor por defecto
    // (auto-trailing-slash) Cloudflare redirigiría /post a /post/. Con este, /post/ pasa a /post (que es
    // también como llegan las URLs antiguas de WordPress).
    "html_handling": "drop-trailing-slash",
  },
}
